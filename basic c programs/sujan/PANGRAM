#include<stdio.h>
#include<ctype.h>
#include<string.h>
int main()
{  
    char str[1000];
    int i,n,count=0,count2=0;
    
    fgets(str,1000,stdin);
    str[strcspn(str,"\n")]='\0';
    n=strlen(str);
    int printed[100000]={0};
   
   for(i=0;i<n;i++)
   {
       if(('a'<=str[i]&&'z'>=str[i]))
       {
        if(printed[str[i]]==0)
       {
           count++;
           printed[str[i]]=1; 
       }                           //The quick brown fox jumps over the lazy dog.
       }  
   }
   printf("%d",count);
   if(count==26)
   printf("pangram");
   else
   return 1;
}
